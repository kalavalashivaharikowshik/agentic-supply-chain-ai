# Copy to .env and fill in. Never commit .env.

# --- MySQL (optional) ---
# Leave MYSQLHOST empty to use the built-in SQLite database (data/supply_chain.db)
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=supply_chain
MYSQL_SSL_DISABLED=true

# --- SQLite (used when MYSQLHOST is empty) ---
# SQLITE_PATH=data/supply_chain.db

# --- Neo4j knowledge graph (optional; SQL fallback is used when unset) ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External data sources ---
# Free key from https://newsapi.org (news-based risk detection is skipped without it)
NEWS_API_KEY=
# Set to false to disable all outbound API calls (weather + news)
ENABLE_EXTERNAL_APIS=true
